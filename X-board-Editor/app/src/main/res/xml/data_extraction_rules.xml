<?xml version="1.0" encoding="utf-8"?>
<!--
    ClipNest is intentionally device-local. Exclude every private-storage domain
    from both cloud backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
